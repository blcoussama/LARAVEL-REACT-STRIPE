# Modèle de configuration locale pour LARAVEL-REACT-STRIPE (à copier en .env à la racine).
# Aucune valeur secrète ici : APP_KEY est générée par « php artisan key:generate »,
# les clés Stripe sont celles du MODE TEST de votre compte Stripe.

APP_NAME="Laravel Credits"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite par défaut (fichier database/database.sqlite). Pour MySQL :
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel_credits
# DB_USERNAME=root
# DB_PASSWORD=
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Stripe (mode test uniquement) ---
# Clé secrète de test : tableau de bord Stripe > Développeurs > Clés API (sk_test_...).
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_...) : affiché par « stripe listen --forward-to localhost:8000/buy-credits/webhook ».
STRIPE_WEBHOOK_KEY=
# Devise des paiements (code ISO en minuscules).
STRIPE_CURRENCY=usd

VITE_APP_NAME="${APP_NAME}"
